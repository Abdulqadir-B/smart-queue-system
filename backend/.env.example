# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database Configuration
MONGODB_URI=

# JWT Configuration
# IMPORTANT: Generate a strong random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=1h

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_CREDENTIALS=true

# Rate Limiting Configuration
RATE_LIMIT_GLOBAL_WINDOW_MINS=15
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_QUEUE_WINDOW_SECS=60
RATE_LIMIT_QUEUE_MAX=30
